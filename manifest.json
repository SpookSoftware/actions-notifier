{
  "name": "Github Action Notifier",
  "description": "Notifies when a Github action run completes.",
  "author": "Kory Smith",
  "version": "0.0.1",
  "manifest_version": 3,
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["addNotificationButton.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["notifications", "tabs"],
  "action": {
    "default_popup": "popup.html"
  }
}

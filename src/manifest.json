{
  "name": "CI/CD Workflow Notifications",
  "description": "Adds a button to the Github UI that will trigger a notification when an action or job completes when clicked.",
  "author": "Spook Software",
  "version": "0.9.0",
  "manifest_version": 3,
  "icons": {
    "16": "images/icon-16.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["./addNotificationButton.js"]
    }
  ],
  "background": {
    "service_worker": "./background.js",
    "type": "module"
  },
  "permissions": ["notifications", "alarms", "storage"],
  "action": {
    "default_icon": {
      "16": "images/icon-16.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    },
    "default_popup": "popup.html"
  }
}
